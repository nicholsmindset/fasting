    <!-- Intro pages -->
    <string name="onb_intro_heading">Cara kerja Fasting Shift</string>
    <string name="onb_intro_timer_title">Sekali ketuk, puasa tak pernah hilang</string>
    <string name="onb_intro_timer_body">Mulai dan akhiri dengan sekali ketuk. Puasa Anda tersimpan sejak dimulai, jadi tetap aman meski ponsel dimulai ulang, baterai habis, atau zona waktu berubah.</string>
    <string name="onb_intro_safety_title">Keselamatan sudah terpasang</string>
    <string name="onb_intro_safety_body">Beberapa pertanyaan jujur menentukan puasa mana yang kami tawarkan. Puasa yang lebih panjang disertai daftar periksa, cek kondisi, dan panduan lembut untuk mengakhirinya.</string>
    <string name="onb_intro_privacy_title">Catatan puasa Anda</string>
    <string name="onb_intro_privacy_body">Tidak perlu akun. Catatan puasa dan kesehatan Anda dienkripsi di perangkat ini. Anda dapat memilih untuk menggunakan Health Connect atau menyimpan salinan ke file.</string>
    <string name="onb_intro_page">Halaman %1$d dari %2$d</string>

    <!-- Goal / protocol -->
    <string name="onb_goal_body">Ini membantu kami menyarankan titik awal. Anda dapat mengubahnya nanti.</string>
    <string name="onb_protocol_daily">Jendela harian</string>
    <string name="onb_protocol_longer">Puasa lebih panjang dan mingguan</string>
    <string name="onb_protocol_show_more">Tampilkan puasa lebih panjang</string>
    <string name="onb_protocol_recommended">Disarankan untuk tujuan Anda</string>
    <string name="onb_protocol_long_note">Kami memulai Anda dengan 16:8. Tingkatkan ke puasa yang lebih panjang setelah beberapa minggu, saat puasa harian sudah terasa mudah.</string>
