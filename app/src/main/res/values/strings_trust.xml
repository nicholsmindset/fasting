    <!-- Trust center -->
    <string name="trust_row">How your data is protected</string>
    <string name="trust_title">Trust center</string>
    <string name="trust_intro">Fasting Shift is built so your health data stays yours. Here is exactly what that means.</string>
    <string name="trust_on_device_title">Your data stays on this phone</string>
    <string name="trust_on_device_body">Fasts, logs, check-ins and safety answers are stored only on this device. There is no Fasting Shift server and no cloud copy, and Android\'s automatic backup is turned off for this app.</string>
    <string name="trust_encrypted_title">Encrypted</string>
    <string name="trust_encrypted_body">The database is encrypted with SQLCipher. Its key is protected by the Android Keystore on this phone.</string>
    <string name="trust_no_account_title">No account</string>
    <string name="trust_no_account_body">You never sign up or sign in. There is no email or profile to leak.</string>
    <string name="trust_no_tracking_title">No ads and no tracking</string>
    <string name="trust_no_tracking_body">The app contains no advertising, tracking or health-analytics tools. Your health records are never sold or used for marketing.</string>
    <string name="trust_leaves_title">What leaves this phone, and when</string>
    <string name="trust_leaves_purchases_title">Purchases: Google Play and RevenueCat</string>
    <string name="trust_leaves_purchases_body">Each time the app opens, it checks Shift+ with Google Play and RevenueCat, our billing service, using a generated app ID, even if you never buy. They handle purchase and basic device information, never your fasts, screening answers or measurements.</string>
    <string name="trust_leaves_hc_title">Health Connect: only if you turn it on</string>
    <string name="trust_leaves_hc_body">If you turn on Health Connect in Settings, the app exchanges only the data types you allow (such as weight, water and glucose) with Health Connect on this phone.</string>
    <string name="trust_leaves_files_title">Files: only when you export or share</string>
    <string name="trust_leaves_files_body">Exports, backups, doctor reports and share cards are created on this phone and go only where you send them.</string>
    <string name="trust_leaves_links_title">Challenge links: settings only</string>
    <string name="trust_leaves_links_body">A challenge link holds only the challenge (type, dates and an optional name). Everyone tracks their own progress on their own phone.</string>
    <string name="trust_your_data">Your data</string>
    <string name="trust_export">Export a copy of my data</string>
    <string name="trust_export_subtitle">A zip with a full backup and spreadsheet files</string>
    <string name="trust_delete">Delete all data</string>
    <string name="trust_deleting">Deleting…</string>
    <string name="trust_delete_footer">Deleting removes everything this app stores on this phone and restarts it fresh. Export first if you want to keep a copy.</string>
    <string name="trust_delete_confirm_title">Delete all data?</string>
    <string name="trust_delete_confirm_body">Your fasts, logs, check-ins, safety answers, challenges and settings will be permanently removed from this phone. Files you exported and data in Health Connect are not affected. Your Shift+ purchase stays with your Google Play account. This can\'t be undone.</string>
    <string name="trust_delete_confirm">Delete everything</string>

    <!-- Ramadan safety card -->
    <string name="ramadan_safety_title">Fasting with diabetes medicine</string>
    <string name="ramadan_safety_clinician">Insulin and sulfonylureas can cause low blood sugar while fasting. Please talk to your doctor before Ramadan about the timing and dose of your medicine.</string>
    <string name="ramadan_safety_break_title">Break your fast straight away if you feel:</string>
    <string name="ramadan_safety_break_body">shaky, sweaty, confused or very weak, or if you feel unwell in any way.</string>
    <string name="ramadan_safety_allowed">Protecting your health comes first. Breaking a fast when you are unwell is allowed, and the day can be made up later.</string>
    <string name="ramadan_safety_emergency">In an emergency, call %1$s</string>

