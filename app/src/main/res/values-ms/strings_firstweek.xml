    <!-- Intro pages -->
    <string name="onb_intro_heading">Cara Fasting Shift berfungsi</string>
    <string name="onb_intro_timer_title">Satu ketikan, dan puasa anda tidak akan hilang</string>
    <string name="onb_intro_timer_body">Mula dan tamat dengan satu ketikan. Puasa anda disimpan sebaik sahaja ia bermula, jadi ia kekal walaupun telefon dimulakan semula, bateri habis atau zon waktu berubah.</string>
    <string name="onb_intro_safety_title">Keselamatan terbina dalam</string>
    <string name="onb_intro_safety_body">Beberapa soalan jujur menentukan puasa yang kami tawarkan. Puasa yang lebih panjang disertakan dengan senarai semak, semakan berkala dan panduan lembut untuk menamatkannya.</string>
    <string name="onb_intro_privacy_title">Rekod puasa anda</string>
    <string name="onb_intro_privacy_body">Anda tidak memerlukan akaun. Rekod puasa dan kesihatan anda disulitkan pada peranti ini. Anda boleh memilih untuk menggunakan Health Connect atau menyimpan salinan dalam fail.</string>
    <string name="onb_intro_page">Halaman %1$d daripada %2$d</string>

    <!-- Goal / protocol -->
    <string name="onb_goal_body">Ini membantu kami mencadangkan titik permulaan. Anda boleh mengubahnya kemudian.</string>
