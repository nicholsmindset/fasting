<!-- Strings for platform integrations: widgets, notifications, reliability and recovery. -->
<resources>
    <!-- Widgets -->
    <string name="widget_open_app">打开应用</string>

    <!-- Reliability check: a single notification channel switched off -->
    <string name="rel_channel_title">%1$s通知</string>
