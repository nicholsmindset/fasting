    <!-- Extended fast checklist (F7). Pending clinician review. -->
    <string name="checklist_title">长时间断食之前</string>
    <string name="checklist_hydration">断食期间持续喝水。</string>
    <string name="checklist_electrolytes">规划好电解质补充（钠、钾、镁）。</string>
    <string name="checklist_medications">如果你正在服用任何药物，请先咨询医生。</string>
    <string name="checklist_contact">告诉身边的人你在进行长时间断食，以及身体不适时该联系谁。</string>
    <string name="checklist_redflags">如出现晕厥、胸痛、心悸、意识混乱或严重乏力，请立即停止并就医。</string>
    <string name="checklist_over72">你计划进行超过 72 小时的断食。这么长时间的断食风险更高，请确认你已了解。</string>
    <string name="disclaimer">Fasting Shift 不提供医疗建议，也不诊断或治疗任何疾病。</string>
    <string name="checklist_confirm">我已了解</string>
    <string name="cancel">取消</string>
    <string name="ok">确定</string>

    <!-- Refeeding guidance (F7, SR-5). Placeholder copy pending clinician review. -->
    <string name="refeed_title">结束长时间断食</string>
    <string name="refeed_standard">先吃一小份容易消化的食物，比如清汤、鸡蛋或酸奶。慢慢吃，过一会儿再吃正餐。</string>
    <string name="refeed_extended">断食 3 天或以上后，恢复进食的第一天要温和：少量多餐、低糖，并补充电解质。</string>
    <string name="refeed_prolonged">非常长时间的断食后，恢复进食需要格外小心。前几天保持少量进食；如果感到虚弱、意识混乱、呼吸急促或出现水肿，请联系医生。</string>
